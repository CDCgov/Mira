#!/bin/bash

# Exit immediately if any command fails
set -e

# Get current script directory ####
FRONTEND_DIR="$( realpath $(dirname "${BASH_SOURCE[0]}") )"

# Command-line argument usage
print_usage() {
    cat <<USAGE
Usage: $(basename "$0") [-h] [--help] --react_port <REACT_PORT> --api_port <API_PORT>

Arguments:
  --react_port <REACT_PORT>   Port to serve the React app on. (Default: 5175)
  --api_port <API_PORT>       Port to serve the API app on. (Default: 8080)
  -h, --help                  Show this help message and exit.
USAGE
}

usage() {
    print_usage >&2
    exit 1
}

# Initialize variables
REACT_PORT="5175"
API_PORT="8080"

# Parse named arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            print_usage
            exit 0
            ;;
        --react_port)
            REACT_PORT="$2"
            shift 2
            ;;
        --api_port)
            API_PORT="$2"
            shift 2
            ;;
        *)
            echo "Error: Unknown argument '$1'." >&2
            usage
            ;;
    esac
done

# Make sure required arguments are provided
if [[ -z "${REACT_PORT}" || -z "${API_PORT}" ]]; then
    MISSING_ARGS=()
    [[ -z "${REACT_PORT}" ]] && MISSING_ARGS+=("--react_port")
    [[ -z "${API_PORT}" ]] && MISSING_ARGS+=("--api_port")
    echo ""
    echo "Error: Missing required arguments: ${MISSING_ARGS[*]}" >&2
    usage
fi

# Function to check if a port is available
check_available_port () {
  local label=$1
  local port=$2
  local check_port=$(echo -n $(lsof -i:${port}) | wc -m)
  if [ ${check_port} -gt 0 ]
  then
    echo "Error: The ${label} port ${port} is already in use. Please choose a different port." >&2
    exit 1
  fi
}

# Check if the requested ports are available
check_available_port "REACT" "${REACT_PORT}"

# Update API port in vite.config.js
VITE_CONFIG_FILE="${FRONTEND_DIR}/vite.config.js"
if [[ -f "${VITE_CONFIG_FILE}" ]]; then
    echo ""
    echo "Updating API Port in ${VITE_CONFIG_FILE} to Port ${API_PORT}"
    sed -i "s/127.0.0.1:[0-9]\+/127.0.0.1:${API_PORT}/" "${VITE_CONFIG_FILE}"
else
    cat > "${VITE_CONFIG_FILE}" <<EOF
import { defineConfig } from 'vite'
import react from '@vitejs/plugin-react'

// https://vite.dev/config/
export default defineConfig({
  plugins: [react()],
  server: {
    proxy: {
      '/api': {
        target: 'http://127.0.0.1:${API_PORT}',
        changeOrigin: true,
        rewrite: (path) => path.replace(/^\/api/, ''),
      },
    },
  },
})
EOF
fi

# Navigate to frontend directory
cd "${FRONTEND_DIR}"

# Start the React app in development mode
echo ""
echo "---------------------------------------------------------------------"
echo "- MIRA REACT will be deployed at http://localhost:${REACT_PORT}"
echo "---------------------------------------------------------------------"
echo ""

# Install dependencies listed in package-lock.json and clean npm cache
npm install && npm run dev -- --host "0.0.0.0" --port "${REACT_PORT}"
