#!/bin/bash

# Exit immediately if any command fails
set -e

# Get current script directory ####
BACKEND_DIR="$( realpath $(dirname "${BASH_SOURCE[0]}") )"

# Command-line argument usage
print_usage() {
    cat <<USAGE
Usage: $(basename "$0") [-h] [--help] --deploy <DEPLOY> --data_dir <DATA_ROOT> --mira_nf_image <MIRA_NF_IMAGE> --api_port <API_PORT> --react_port <REACT_PORT>

Arguments:
    Required:
    --deploy <DEPLOY>                 Deployment mode, must be 'Local' or 'Docker'.
    --data_dir <DATA_ROOT>            Path to host directory to store outputs from MIRA applications.
    --mira_nf_image <MIRA_NF_IMAGE>   Docker image (name:tag) to run the MIRA Nextflow pipeline.
    --api_port <API_PORT>             Port to launch MIRA API on. (Default: 8080)
    --react_port <REACT_PORT>         Port to launch MIRA REACT on. (Default: 5175)

    Optional:
    -h, --help                        Show this help message and exit.
USAGE
}

usage() {
    print_usage >&2
    exit 1
}

# Initialize variables
DEPLOY=""
DATA_ROOT=""
MIRA_NF_IMAGE=""
API_PORT="8080"
REACT_PORT="5175"

# Parse named arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            print_usage
            exit 0
            ;;
        --deploy)
            DEPLOY="$2"
            shift 2
            ;;
        --data_dir)
            DATA_ROOT="$2"
            shift 2
            ;;
        --mira_nf_image)
            MIRA_NF_IMAGE="$2"
            shift 2
            ;;
        --api_port)
            API_PORT="$2"
            shift 2
            ;;        
        --react_port)
            REACT_PORT="$2"
            shift 2
            ;;
        *)
            echo "Error: Unknown argument '$1'." >&2
            usage
            ;;
    esac
done

# Only --deploy, --data_dir and --mira_nf_image are required; the rest have defaults
if [[ -z "${DEPLOY}" || -z "${DATA_ROOT}" || -z "${MIRA_NF_IMAGE}" || -z "${API_PORT}" || -z "${REACT_PORT}" ]]; then
    MISSING_ARGS=()
    [[ -z "${DEPLOY}" ]] && MISSING_ARGS+=("--deploy")
    [[ -z "${DATA_ROOT}" ]] && MISSING_ARGS+=("--data_dir")
    [[ -z "${MIRA_NF_IMAGE}" ]] && MISSING_ARGS+=("--mira_nf_image")
    [[ -z "${API_PORT}" ]] && MISSING_ARGS+=("--api_port")
    [[ -z "${REACT_PORT}" ]] && MISSING_ARGS+=("--react_port")
    echo ""
    echo "Error: Missing required arguments: ${MISSING_ARGS[*]}" >&2
    usage
fi

# Validate --deploy argument
if [[ "${DEPLOY}" != "Local" && "${DEPLOY}" != "Docker" ]]; then
    echo ""
    echo "Error: Invalid value for --deploy. Must be 'Local' or 'Docker'." >&2
    usage
fi

# Validate --data_dir argument
if [[ ! -d "${DATA_ROOT}" ]]; then
    echo ""
    echo "Error: The data directory '${DATA_ROOT}' does not exist. Please create it before proceeding." >&2
    usage
fi

# Function to check if a port is available
check_available_port () {
  local label=$1
  local port=$2
  local check_port=$(echo -n $(lsof -i:${port}) | wc -m)
  if [ ${check_port} -gt 0 ]
  then
    echo "Error: The ${label} port ${port} is already in use. Please choose a different port." >&2
    exit 1
  fi
}

# Check if the API port is available
check_available_port "API" "${API_PORT}"

# Generate config.yml to be used by the backend app
CONFIG_FILE="${BACKEND_DIR}/config.yml"
echo ""
echo -e "Writing\nDEPLOY=${DEPLOY},\nDATA_ROOT=${DATA_ROOT},\nMIRA_NF_IMAGE=${MIRA_NF_IMAGE},\nAPI_PORT=${API_PORT},\nREACT_PORT=${REACT_PORT}\nto ${CONFIG_FILE}"
cat > "${CONFIG_FILE}" <<EOF
DEPLOY: ${DEPLOY}
DATA_ROOT: ${DATA_ROOT}
MIRA_NF_IMAGE: ${MIRA_NF_IMAGE}
API_PORT: ${API_PORT}
REACT_PORT: ${REACT_PORT}
EOF

# Navigate to backend directory
cd "${BACKEND_DIR}"

# Start the FastAPI app using Uvicorn in the background
echo ""
echo "-----------------------------------------------------------------------------------------------------------------------------"
echo "- MIRA API will be deployed at http://localhost:${API_PORT}, with interactive docs at http://localhost:${API_PORT}/docs/"
echo "-----------------------------------------------------------------------------------------------------------------------------"
echo ""

# Start the FastAPI app using Uvicorn
uvicorn app.main:app --reload --reload-dir app --host "0.0.0.0" --port "${API_PORT}"